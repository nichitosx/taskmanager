__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Локальные данные приложения (портативный режим)
data/
portable.flag
*.db
*.ico
*.lnk

# Шрифты пользователя: распространять их нельзя.
# Исключение — папка bundled: там только свободные шрифты под лицензией OFL.
fonts/*.ttf
fonts/*.otf
fonts/*.ttc
!fonts/bundled/

# Собранные архивы
dist/

# Служебное
.idea/
.vscode/
*.log
